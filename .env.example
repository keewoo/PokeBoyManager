# Copier en .env pour surcharger les valeurs par défaut de docker-compose.yml.
# Aucune valeur réelle ici — uniquement les identifiants de développement local.

# --- PostgreSQL ---
POSTGRES_USER=pbm
POSTGRES_PASSWORD=pbm
POSTGRES_DB=pbm
POSTGRES_PORT=55432

# --- Redis ---
REDIS_PORT=56379

# --- MinIO (S3 compatible) ---
MINIO_ROOT_USER=pbm
MINIO_ROOT_PASSWORD=pbmpbmpbm
MINIO_API_PORT=59000
MINIO_CONSOLE_PORT=59001

# --- Mailpit ---
MAILPIT_SMTP_PORT=51025
MAILPIT_UI_PORT=58025

# --- apps/api (consommées par pbm_api.config.Settings) ---
DATABASE_URL=postgresql+asyncpg://pbm:pbm@localhost:55432/pbm
REDIS_URL=redis://localhost:56379/0
S3_ENDPOINT_URL=http://localhost:59000
S3_ACCESS_KEY=pbm
S3_SECRET_KEY=pbmpbmpbm
S3_BUCKET=pbm
S3_REGION=us-east-1
SMTP_HOST=localhost
SMTP_PORT=51025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@pokeboymanager.local

# --- apps/api : authentification (lot v1-auth) ---
# SECRET_KEY : dev uniquement, aucune valeur réelle ici — signe les jetons CSRF (HMAC du
# cookie de session). À définir par une variable d'environnement propre à chaque déploiement.
SECRET_KEY=dev-only-change-me-in-production
APP_PUBLIC_URL=http://localhost:3000
SESSION_COOKIE_NAME=pbm_session
CSRF_COOKIE_NAME=pbm_csrf
SESSION_TTL_DAYS=30
EMAIL_TOKEN_TTL_MINUTES=60
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# --- apps/api : coffre de clés IA (lot v1-byok) ---
# AI_KEY_ENCRYPTION_KEY : dev uniquement, aucune valeur réelle ici — clé maître AES-256 (32
# octets, base64) qui chiffre/déchiffre les clés IA des utilisateurs. À définir par une
# variable d'environnement propre à chaque déploiement, jamais en base.
AI_KEY_ENCRYPTION_KEY=bo8a8UxneCy51yL6Mhan73p0Yxh+tKGlj4cIAbrfRvo=

# --- apps/api : stockage des photos (lots v3-upload, v1-profil) ---
# D7 : "s3" en dev/CI (MinIO), "local" en UAT/PROD (disque du serveur, PHOTOS_STORAGE_PATH,
# pas de Docker — voir docs/infra/SERVEUR-POKEBOY.md). Sert les photos de cartes (v3-upload)
# et l'avatar utilisateur (v1-profil).
STORAGE_BACKEND=s3
PHOTOS_STORAGE_PATH=./var/photos
UPLOAD_MAX_SIZE_BYTES=20971520
UPLOAD_MAX_FILES_PER_BATCH=30

# --- apps/web ---
NEXT_PUBLIC_API_URL=http://localhost:8000
# Doit rester alignée avec SESSION_COOKIE_NAME ci-dessus (garde de route middleware).
NEXT_PUBLIC_SESSION_COOKIE_NAME=pbm_session
# Doit rester alignée avec CSRF_COOKIE_NAME ci-dessus (lot v3-upload : en-tête X-CSRF-Token).
NEXT_PUBLIC_CSRF_COOKIE_NAME=pbm_csrf
